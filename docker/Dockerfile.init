# ─────────────────────────────────────────────────────────────────
# WordPress init container — one-shot setup
#   - Built on wordpress:cli (includes wp-cli, no Apache).
#   - Shares the wp_data volume with the wordpress service.
#   - Runs /usr/local/bin/init-wordpress.sh which is fully idempotent
#     (safe to re-run on every redeploy).
#   - restart: "no" in compose; the orchestrator service depends on
#     service_completed_successfully so it only starts once init
#     finishes cleanly.
# ─────────────────────────────────────────────────────────────────

FROM wordpress:cli-php8.3

# The init script is mounted from the build context so changes to it
# don't require rebuilding the wordpress image.
# COPY --chmod=755 sets the executable bit at copy time, avoiding
# `chmod +x` failures when the image's default USER is non-root.
COPY --chmod=755 docker/init-wordpress.sh /usr/local/bin/init-wordpress.sh

# Run as root so we can read/write wp-config.php regardless of its current
# owner. The wordpress entrypoint may not have finished chown'ing files
# to www-data when init starts, so we need root access.
# After init runs, we chown files to www-data so the wordpress service
# (which runs as www-data after its entrypoint) can manage them.
USER root

ENTRYPOINT ["/usr/local/bin/init-wordpress.sh"]