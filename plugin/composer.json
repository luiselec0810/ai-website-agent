{
    "name": "ai-website-agent/ai-website-bridge",
    "description": "WordPress plugin that exposes a safe REST API for AI agents to read, create and modify WordPress sites built with Elementor.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "AI Website Agent Team"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.0",
        "wp-phpunit/wp-phpunit": "^6.5",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-coding-standards/wpcs": "^3.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "AIWebsiteBridge\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AIWebsiteBridge\\Tests\\": "tests/unit/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:setup": "bash tests/install-wp-tests.sh",
        "phpcs": "phpcs --standard=WordPress --extensions=php --ignore=vendor/,tests/ includes/ ai-website-bridge.php"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
