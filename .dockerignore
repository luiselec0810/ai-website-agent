# ─────────────────────────────────────────────────────────────────
# .dockerignore — exclude dev artifacts from Docker build context
# Keeps context <5 MB (was ~70 MB without this file)
# ─────────────────────────────────────────────────────────────────

# Dependencies
**/node_modules
**/vendor

# VCS
**/.git
**/.gitignore
**/.gitattributes

# Build outputs (these are GENERATED inside the image, not copied)
**/.next
**/dist
**/.cache
**/coverage

# Runtime data
**/data
**/*.db
**/*.sqlite
**/*.sqlite3

# Environment & secrets — never bake these into images
**/.env
**/.env.*
!**/.env.example

# Tests & docs (not needed at runtime)
**/tests
**/tests-e2e
**/__tests__
**/docs

# Test artifacts
**/playwright-report
**/test-results
**/junit.xml

# Large media assets
public/*.mp4
public/*.mov
public/*.webm
public/*.avi
public/*.mkv

# Plugin zip + plugin dev deps cache
ai-website-bridge.zip
**/.phpunit.result.cache

# OS junk
**/.DS_Store
**/Thumbs.db
**/desktop.ini

# IDEs
**/.vscode
**/.idea
**/*.swp
**/*.swo

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Misc
**/coverage
**/.nyc_output
**/.history