# ─────────────────────────────────────────────────────────────────
# AI Website Agent - Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copiar a .env y editar antes de levantar docker-compose up
# ─────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────
# Proveedor LLM (sin default — debes elegir uno y configurarlo)
# ─────────────────────────────────────────────────────────────────
# Opciones: "anthropic" | "openai" | "ollama"
LLM_PROVIDER=minimax

# Modelo a usar (depende del proveedor):
#   Anthropic: claude-sonnet-4-5 | claude-opus-4-8 | claude-haiku-4-5
#   OpenAI:    gpt-4o | gpt-5 | o1
#   Ollama:    llama3.1 | qwen2.5 | mistral
LLM_MODEL=MiniMax-M3

# API Key del proveedor elegido (NO hardcodear en producción).
# Para Anthropic: https://console.anthropic.com/
# Para OpenAI:    https://platform.openai.com/api-keys
# Para Ollama:    no requiere API key, solo URL
# Para Minimax M3: https://console.minimax.io/  (API key tipo sk-mm-…)
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
OPENAI_API_KEY=sk-REPLACE-ME
OLLAMA_BASE_URL=http://host.docker.internal:11434
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=sk-api-fH831urpyYvtafejNODzvQuYV5rWs2Bwu1YRwG_R7dK7zxec6xLmODJh0mJ7CQydw20DbgkntDVNTCCbo1r9kXK00xYYY2Xd9iGPNj0JzlCo1YRmhgy62XU

# ─────────────────────────────────────────────────────────────────
# Credenciales por defecto de WordPress (para docker-compose)
# ─────────────────────────────────────────────────────────────────
# API Key que se creará automáticamente en WordPress durante el init.
# La usarás para conectar el Orchestrator al sitio por defecto.
DEFAULT_WP_API_KEY=aiw_ZrOPFYwgLWsOLhnF6hHJS0LXGGhMxeq6Zq0-khs6MvlJKbB8lcF0qw

# ─────────────────────────────────────────────────────────────────
# Configuración del Orchestrator
# ─────────────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=4000
DATABASE_PATH=/data/orchestrator.db
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────
# Configuración del Frontend
# ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000

# ─────────────────────────────────────────────────────────────────
# WordPress (no tocar — son los defaults de docker-compose)
# ─────────────────────────────────────────────────────────────────
WORDPRESS_PORT=8000
MYSQL_PORT=3306
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_NAME=wordpress
