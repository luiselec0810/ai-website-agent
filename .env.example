# ─────────────────────────────────────────────────────────────────
# AI Website Agent - Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copiar a .env y editar antes de levantar:
#   - DEV:  docker-compose -f docker-compose.dev.yml up -d
#   - PROD: las mismas vars se inyectan desde el panel de Dokploy
# ─────────────────────────────────────────────────────────────────
#
# ⚠️  ATENCIÓN — SECRETOS EXPUESTOS
# ─────────────────────────────────────────────────────────────────
# Las versiones previas de este archivo contenían valores REALES de:
#   - MINIMAX_API_KEY       (sk-api-fH831urpy…)
#   - DEFAULT_WP_API_KEY    (aiw_ZrOPFYwgL…)
# Además, orchestrator/.env (ignorado por .gitignore) contenía:
#   - GEMINI_API_KEY        (AIzaSy…)
#
# Si alguna vez pusheaste esos valores al repo remoto, ya están
# EXPUESTOS en git history y deben ser revocados en el panel del
# proveedor ANTES del primer deploy en Dokploy.
#
# Acción inmediata:
#   1. Revocar las 3 keys en sus respectivos paneles.
#   2. Generar keys nuevas.
#   3. Pegarlas SOLO en el panel de Dokploy (o en un .env local que NO
#      se commitee).
# ─────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────
# Proveedor LLM (sin default — debes elegir uno y configurarlo)
# ─────────────────────────────────────────────────────────────────
# Opciones: "anthropic" | "openai" | "ollama" | "minimax" | "gemini"
LLM_PROVIDER=minimax

# Modelo a usar (depende del proveedor):
#   Anthropic: claude-sonnet-4-5 | claude-opus-4-8 | claude-haiku-4-5
#   OpenAI:    gpt-4o | gpt-5 | o1
#   Ollama:    llama3.1 | qwen2.5 | mistral
#   Gemini:    gemini-3.1-pro-preview (recomendado)
#   Minimax M3: MiniMax-M3
LLM_MODEL=MiniMax-M3

# API Key del proveedor elegido. NO hardcodear en producción.
#   Anthropic: https://console.anthropic.com/
#   OpenAI:    https://platform.openai.com/api-keys
#   Ollama:    no requiere API key, solo URL
#   Minimax:   https://console.minimax.io/  (API key tipo sk-mm-…)
#   Gemini:    https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
OPENAI_API_KEY=sk-REPLACE-ME
OLLAMA_BASE_URL=http://host.docker.internal:11434
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=__set_in_dokploy_panel__
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=__set_in_dokploy_panel__

# ─────────────────────────────────────────────────────────────────
# API Key por defecto para el plugin AI Website Bridge en WP
# ─────────────────────────────────────────────────────────────────
# El init script crea esta key en WordPress vía wp eval. Generala con:
#   openssl rand -base64 32 | head -c 48 ; echo aiw_
DEFAULT_WP_API_KEY=__generate_with_openssl_rand__

# ─────────────────────────────────────────────────────────────────
# Configuración del Orchestrator
# ─────────────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=4000
DATABASE_PATH=/data/orchestrator.db
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────
# Configuración del Frontend
# ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000

# ─────────────────────────────────────────────────────────────────
# WordPress (no tocar — son los defaults de docker-compose.dev.yml)
# ─────────────────────────────────────────────────────────────────
WORDPRESS_PORT=8000
MYSQL_PORT=3306
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_NAME=wordpress

# ═════════════════════════════════════════════════════════════════
# DOKPLOY / PRODUCCIÓN
# ═════════════════════════════════════════════════════════════════
# Estas vars se inyectan desde el panel de Dokploy (no hace falta
# pegarlas en .env local). Documentadas aquí como referencia.
# ═════════════════════════════════════════════════════════════════

# Hosts públicos (DNS wildcard *.app.example.com debe apuntar a Dokploy)
WP_HOST=wp.app.example.com
FRONT_HOST=app.example.com

# Metadata del sitio WordPress
WP_TITLE=AI Agent Demo Site
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=__set_in_dokploy_panel__       # NO usar "admin"
WP_ADMIN_EMAIL=ops@example.com

# MySQL (cambiar de defaults)
MYSQL_ROOT_PASSWORD=__set_in_dokploy_panel__
MYSQL_USER=wordpress
MYSQL_PASSWORD=__set_in_dokploy_panel__          # NO usar "wordpress"
MYSQL_DATABASE=wordpress

# Secreto para firmar tokens internos del orchestrator (32 bytes base64)
# Generar con: openssl rand -base64 32
ORCHESTRATOR_MASTER_KEY=__openssl_rand_base64_32__