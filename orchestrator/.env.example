# ─────────────────────────────────────────────────────────────────
# AI Orchestrator - Environment Variables
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────
# LLM Provider (configurable, sin default hardcodeado)
# ─────────────────────────────────────────────────────────────────
# Opciones: "anthropic" | "openai" | "ollama" | "minimax" | "gemini"
# Recomendado por defecto: Gemini 3.1 Pro (Google AI Studio, OpenAI-compatible).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-pro-preview

# API Keys (solo la del proveedor elegido es obligatoria)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Minimax M3 (OpenAI-compatible)
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=

# Gemini (Google AI Studio) — OpenAI-compatible endpoint.
# Obtén tu API key en https://aistudio.google.com/apikey
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────
# WordPress site por defecto
# ─────────────────────────────────────────────────────────────────
DEFAULT_WP_URL=http://wordpress
DEFAULT_WP_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────
DATABASE_PATH=/data/orchestrator.db

# ─────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
